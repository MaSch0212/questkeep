{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Questkeep",
  "version": "0.2.0",
  "identifier": "dev.masch0212.questkeep",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Questkeep",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "backgroundColor": "#121417",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3RkFBRDQ3MkEyNjY5QTIKUldTaWFTWXFSNjM2Rnl4RG5vUVQzMEQzOFE2MUVxbVRWbmhLdXczc2U4blBJaFhlbWlvRjYrUlQK",
      "endpoints": ["https://github.com/MaSch0212/questkeep/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}